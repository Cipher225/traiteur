# ============================================================================
#  VARIABLES D'ENVIRONNEMENT — à définir dans Dokploy (onglet Environment)
#  Copiez ce fichier en .env pour un test local Docker, ou renseignez ces
#  valeurs directement dans l'interface Dokploy.
# ============================================================================

# Nom de la base de données
DB_NAME=traiteur_db

# Utilisateur applicatif de la base
DB_USER=traiteur

# Mot de passe de l'utilisateur (CHOISISSEZ UN MOT DE PASSE FORT)
DB_PASS=remplacez_par_un_mot_de_passe_fort

# Mot de passe root de MariaDB (autre mot de passe fort)
DB_ROOT_PASS=remplacez_par_un_autre_mot_de_passe_fort

# Adresse publique du site (avec https://), une fois le domaine configuré
SITE_URL=https://votre-domaine.com

# Connexion Google (facultatif — laissez vide pour masquer le bouton)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
